          {
            "name": "originDisputeDate[le]",
            "in": "query",
            "description": "Filtrar até uma data de abertura de chargeback.",
            "schema": {
              "type": "string",
              "example": "2024-12-05"
            }
          },
          {
            "name": "originDisputeDate[ge]",
            "in": "query",
            "description": "Filtrar a partir de uma data de abertura de chargeback.",
            "schema": {
              "type": "string",
              "example": "2023-11-01"
            }
          },
          {
            "name": "originTransactionDate[le]",
            "in": "query",
            "description": "Filtrar até uma data de transação.",
            "schema": {
              "type": "string",
              "example": "2024-12-05"
            }
          },
          {
            "name": "originTransactionDate[ge]",
            "in": "query",
            "description": "Filtrar a partir de uma data de transação.",
            "schema": {
              "type": "string",
              "example": "2024-10-10"
            }
          },
          {
            "name": "status",
