                "MASTERCARD",
                "ELO",
                "DINERS",
                "DISCOVER",
                "AMEX",
                "CABAL",
                "BANESCARD",
                "CREDZ",
                "SOROCRED",
                "CREDSYSTEM",
                "JCB",
                "UNKNOWN"
              ],
              "x-readme-ref-name": "ChargebackListRequestCreditCardBrand"
